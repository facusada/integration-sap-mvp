APP_ENV=dev
LOG_LEVEL=INFO

# Keep mock mode enabled until SAP DEV connectivity is approved and PyRFC/NW RFC SDK are installed.
SAP_RFC_MOCK_MODE=true

# SAP RFC connection values. Do not commit real credentials.
SAP_RFC_ASHOST=
SAP_RFC_SYSNR=
SAP_RFC_CLIENT=
SAP_RFC_USER=
SAP_RFC_PASSWD=
SAP_RFC_LANG=EN

# Optional defaults for API queries.
SAP_DEFAULT_SYSTEM_ID=DEV
